/usr/bin/python3 - "$V1/PAIRS.md" "$E/PAIRS.md" <<'EOF'
import sys
src, dst = sys.argv[1:3]
head, rows = [], []
for line in open(src, encoding="utf-8"):
    if line.startswith("| ") and not line.startswith("| #") and not line.startswith("|---"):
        c = [x.strip() for x in line.rstrip("\n").split("|")[1:-1]]
        rows.append([c[1], c[2]])
    else:
        head.append(line)
rows[11] = ["An entry with a detail missing, a date of birth not written as year, month and day or not naming a real day, or a school other than the three is refused before the search; the clerk is told each fault, and nothing is saved.",
            "K12a, K12b, K13a, K13b, K14, K39a, K39b, K40b"]
rows.insert(12, ["A name is not limited in length, and no character in it is refused.", "K40a, K33b"])
# old 22 (index 21) is now index 22; insert after it
assert rows[22][0].startswith("The invented data is made so"), rows[22][0]
rows.insert(23, ["None of the eight differs in capital letters alone, so the figure does not show capital letters being set aside.", "K41a, K41b, K41c, K40b"])
for r in rows:
    if r[0] in ("It is connected to no other body.",) or r[0].startswith("The three lists are part of the invented data"):
        r[1] += ", K32b"
h = "".join(head).replace("# PAIRS — each sentence of the note, with the claim rows of CLAIMS.md it rests on",
    "# PAIRS — each sentence of the note, with the claim rows of CLAIMS.md it rests on (version 2)\n\nVersion 2: version 1's 34 rows, with sentence 12 changed, sentences 13 and 24 added, and K32b added to sentences 28 and 29.")
out = h.rstrip("\n") + "\n"
for i, r in enumerate(rows, 1):
    out += "| %d | %s | %s |\n" % (i, r[0], r[1])
open(dst, "w", encoding="utf-8").write(out)
print(len(rows))
EOF
